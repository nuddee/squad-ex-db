# Public browser + server URL for your Supabase project:
NEXT_PUBLIC_SUPABASE_URL=https://emqooadipseotdbzqtbd.supabase.co

# Public publishable key (code checks NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY first, then NEXT_PUBLIC_SUPABASE_ANON_KEY as fallback):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional server-side URL override (falls back to NEXT_PUBLIC_SUPABASE_URL when omitted):
SUPABASE_URL=https://emqooadipseotdbzqtbd.supabase.co

# Server-only secret key (accepts an `sb_secret_...` key or legacy `service_role` JWT).
# Never expose this key to the browser or commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_KEY

# Server-only token required by CLI / machine calls to POST /api/admin/import (>= 32 chars; generate with `pnpm gen-token`):
ADMIN_IMPORT_TOKEN=run-pnpm-gen-token-to-generate-48-char-secret

# Optional HTTP Basic Auth perimeter gate (default off = 0).
# Set DASHBOARD_BASIC_AUTH_ENABLED=1 if you want an extra HTTP Basic Auth prompt in front of the app (e.g. shared staging URL).
DASHBOARD_BASIC_AUTH_ENABLED=0
DASHBOARD_BASIC_AUTH_USER=operator
DASHBOARD_BASIC_AUTH_PASSWORD=change-me-strong-password
