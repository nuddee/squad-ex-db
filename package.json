{
  "name": "agrivision-qc-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check-env": "tsx --env-file-if-exists=.env.local scripts/check-env.ts",
    "gen-token": "tsx scripts/gen-token.ts",
    "import-csv": "tsx --env-file-if-exists=.env.local scripts/import-csv.ts",
    "create-device": "tsx --env-file-if-exists=.env.local scripts/create-device.ts",
    "bootstrap-admin": "tsx --env-file-if-exists=.env.local scripts/bootstrap-admin.ts",
    "cleanup-test-data": "tsx --env-file-if-exists=.env.local scripts/cleanup-test-data.ts",
    "smoke": "tsx --env-file-if-exists=.env.local scripts/smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "parity:export": "node -e \"const{execFileSync:e}=require('child_process');const py=process.env.LEGACY_PYTHON||'../venv/Scripts/python.exe';const lg=process.env.LEGACY_FILE||'../x-26-10.py';const f=require('fs').readdirSync('parity/fixtures').filter(x=>x.endsWith('.csv')).map(x=>'parity/fixtures/'+x);e(py,['parity/legacy_export.py',lg,'parity/legacy-output.json',...f],{stdio:'inherit'})\"",
    "parity": "pnpm parity:export && tsx parity/compare.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
